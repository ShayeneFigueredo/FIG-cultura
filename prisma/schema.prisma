generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(uuid())
  name                String
  email               String           @unique
  password            String
  role                String           @default("USER")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  avatarUrl           String?
  properties          Property[]
  propertyMemberships PropertyMember[]
  chatSessions        ChatSession[]
}

model Property {
  id        String           @id @default(uuid())
  userId    String
  name      String
  city      String
  state     String
  totalArea Float
  latitude  Float?
  longitude Float?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  fields    Field[]
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  members   PropertyMember[]
}

model PropertyMember {
  id         String   @id @default(uuid())
  propertyId String
  userId     String
  role       String   @default("MEMBER")
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
}

model Field {
  id           String         @id @default(uuid())
  propertyId   String
  name         String
  area         Float
  crop         String?
  latitude     Float?
  longitude    Float?
  coordinates  Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  property     Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  soilAnalyses SoilAnalysis[]
}

model SoilAnalysis {
  id              String                   @id @default(uuid())
  fieldId         String
  date            DateTime
  depth           String
  laboratory      String?
  methodology     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  culturaAnterior String?
  culturaDesejada String?
  sistemaCultivo  String?
  produtividade   Float?
  observacoes     String?
  cropPlannings   CropPlanning[]
  strategies      FertilizationStrategy[]
  recommendations NutrientRecommendation[]
  physicalChars   PhysicalCharacteristics?
  field           Field                    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  parameters      SoilParameter[]
}

model PhysicalCharacteristics {
  id             String       @id @default(uuid())
  soilAnalysisId String       @unique
  argila         Float?
  silte          Float?
  areia          Float?
  classeTextural String?
  densidade      Float?
  soilAnalysis   SoilAnalysis @relation(fields: [soilAnalysisId], references: [id], onDelete: Cascade)
}

model CropPlanning {
  id             String       @id @default(uuid())
  soilAnalysisId String
  fase           String
  diasPosPlantio Int?
  fertilizerId   String?
  doseKgHa       Float?
  fertilizer     Fertilizer?  @relation(fields: [fertilizerId], references: [id])
  soilAnalysis   SoilAnalysis @relation(fields: [soilAnalysisId], references: [id], onDelete: Cascade)
}

model SoilParameter {
  id             String       @id @default(uuid())
  soilAnalysisId String
  element        String
  value          Float
  unit           String
  soilAnalysis   SoilAnalysis @relation(fields: [soilAnalysisId], references: [id], onDelete: Cascade)
}

model RecommendationMethod {
  id     String               @id @default(uuid())
  name   String
  region String
  year   Int
  rules  RecommendationRule[]
}

model RecommendationRule {
  id         String               @id @default(uuid())
  methodId   String
  crop       String
  parameter  String
  rangeMin   Float
  rangeMax   Float
  classLevel String
  formula    String
  method     RecommendationMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
}

model NutrientRecommendation {
  id              String       @id @default(uuid())
  soilAnalysisId  String
  nutrient        String
  recommendedDose Float
  soilAnalysis    SoilAnalysis @relation(fields: [soilAnalysisId], references: [id], onDelete: Cascade)
}

model Fertilizer {
  id            String         @id @default(uuid())
  name          String
  composition   Json
  cropPlannings CropPlanning[]
  strategyItems StrategyItem[]
}

model FertilizationStrategy {
  id             String         @id @default(uuid())
  soilAnalysisId String
  name           String
  totalCost      Float?
  createdAt      DateTime       @default(now())
  soilAnalysis   SoilAnalysis   @relation(fields: [soilAnalysisId], references: [id], onDelete: Cascade)
  items          StrategyItem[]
}

model StrategyItem {
  id           String                @id @default(uuid())
  strategyId   String
  fertilizerId String
  doseKgHa     Float
  pricePerTon  Float?
  fertilizer   Fertilizer            @relation(fields: [fertilizerId], references: [id])
  strategy     FertilizationStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
}

// ---- Chat do Mascote (FIGGER) ----

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
}

model ChatMessage {
  id            String   @id @default(uuid())
  chatSessionId String
  role          String   // "user" | "ai"
  text          String
  createdAt     DateTime @default(now())

  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
}
